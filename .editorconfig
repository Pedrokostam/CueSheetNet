[*.cs]

# CA1510: Use ArgumentNullException throw helper
dotnet_diagnostic.CA1510.severity = silent

# MA0015: Specify the parameter name in ArgumentException
dotnet_diagnostic.MA0015.severity = silent

# IDE0090: Use 'new(...)'
dotnet_diagnostic.IDE0090.severity = silent

# MA0076: Do not use implicit culture-sensitive ToString in interpolated strings
dotnet_diagnostic.MA0076.severity=silent

# MA0038: Make method static
dotnet_diagnostic.MA0038.severity=silent

# MA0011: IFormatProvider is missing
dotnet_diagnostic.MA0011.severity = none

# CS8509: The switch expression does not handle all possible values of its input type (it is not exhaustive). For example, the pattern '...' is not covered.
dotnet_diagnostic.CS8509.severity = error

# CS8524: The switch expression does not handle some values of its input type (it is not exhaustive) involving an unnamed enum value.
dotnet_diagnostic.CS8524.severity = suggestion
